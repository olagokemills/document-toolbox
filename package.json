{
  "name": "private-pdf-local",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev:web": "corepack pnpm --filter local-web dev",
    "build:web": "corepack pnpm --filter local-web build",
    "dev:desktop": "corepack pnpm --filter @private-pdf/desktop dev",
    "build:desktop": "corepack pnpm --filter @private-pdf/desktop build",
    "package:desktop": "corepack pnpm --filter @private-pdf/desktop package",
    "test": "corepack pnpm -r test",
    "lint": "corepack pnpm -r lint",
    "typecheck": "corepack pnpm -r typecheck"
  },
  "devDependencies": {
    "eslint": "^10.4.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.60.0"
  }
}
